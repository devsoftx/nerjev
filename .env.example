# Copy to .env and fill in. .env is gitignored; this file is safe to commit.

# TypeSafe (Jev) - https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Anthropic (Claude, used by the LLM judge) - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model pins. Benchmarks should pin a versioned Jev ID, not the jev-latest alias.
TYPESAFE_DEFAULT_MODEL=jev-1.13.0
JUDGE_MODEL=claude-opus-5

# Neo4j (local docker-compose defaults)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
