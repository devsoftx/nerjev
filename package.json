{
  "name": "nerjev",
  "version": "0.1.0",
  "description": "PDF to knowledge graph: NER and relation extraction with TypeSafe Jev, judged by Claude",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "nerjev": "dist/cli.js"
  },
  "scripts": {
    "nerjev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "NERJEV_LIVE=1 vitest run tests/live",
    "sample-pdf": "tsx scripts/makeSamplePdf.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "commander": "^15.0.0",
    "neo4j-driver": "^6.2.0",
    "p-limit": "^7.3.3",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
